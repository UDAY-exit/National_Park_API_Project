@model NationalPark_WebApplication.Models.NationalPark

@{
    var title = Model.Id != 0 ? "Edit National Park" : "New National Park";
    var saveUpdate = Model.Id != 0 ? "Update" : "Save";
}


<form method="post" enctype="multipart/form-data">
    @if(Model.Id !=0)
        {
            <input type="hidden" asp-for="@Model.Id" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="row-border p-2 m-2">
        <div class="col-10 border-bottom">
            <h2 class="text-primary">@title</h2>
        </div>

        <div class="row">
            <!-- Form Section -->
            <div class="col-8">
                <div class="form-group row p-2 m-2">
                    <div class="col-4">
                        <label asp-for="Name"></label>
                    </div>
                    <div class="col-8">
                        <input type="text" class="form-control" asp-for="Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row p-2 m-2">
                    <div class="col-4">
                        <label asp-for="State"></label>
                    </div>
                    <div class="col-8">
                        <input type="text" class="form-control" asp-for="State" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row p-2 m-2">
                    <div class="col-4">
                        <label asp-for="Picture"></label>
                    </div>
                    <div class="col-8">
                        <input type="file" name="files" id="imageId"
                               class="form-control" />
                    </div>
                </div>


                <div class="form-group row p-2 m-2">

                        @{
                            var estDate = "";
                            if(Model.Id != 0)
                            {
                                estDate = Model.Established.ToShortDateString();
                            }
                        }


                    <div class="col-4">
                        <label asp-for="Established"></label>
                    </div>
                    <div class="col-8">
                        <input type="text" id="datePicker"
                               class="form-control" asp-for="Established" />
                        <span asp-validation-for="Established"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row p-2 m-2">
                    <div class="col-4 offset-4">
                        <button type="submit"
                                class="btn btn-info form-control">
                            @saveUpdate
                        </button>
                    </div>
                    <div class="col-4">
                        <a asp-action="Index"
                           class="btn btn-success form-control">
                            Back To List
                        </a>
                    </div>
                </div>
            </div>

            <!-- Image Display Section -->
            <div class="col-4">
                
                    @if(Model.Picture != null)
                    {
                        var base64 = Convert.ToBase64String(Model.Picture);
                        var imgSrc = String.Format("data:image/jpeg;base64,{0}", base64);
                        <img src="@imgSrc" width="100%" />
                    }

            </div>
        </div>
    </div>
    

    </form>
    @section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function(){
        $("#datePicker").datepicker({
            changeMonth:true,
            changeYear:true
          })
        })
    </script>
    }